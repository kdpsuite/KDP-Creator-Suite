{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://dashboard-backend-hazel.vercel.app/api/:path*"
    },
    {
      "source": "/status",
      "destination": "/status.html"
    },
    {
      "source": "/((?!api/|status(?:\\.html)?$|favicon\\.ico|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
